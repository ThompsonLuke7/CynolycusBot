# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# ============================================================
# Project data & generated artifacts (do not commit)
# ============================================================

# Blanket data-format ignores (re-includes below for configs/live deps)
*.csv
*.parquet
*.parquets
*.json
*.zip
*.dot
*.tgz
*:Zone.Identifier
logs/
local_artifacts/

# Data/ holds generated market data, datasets, and model artifacts.
# Only the utility scripts inside it are source.
Data/**
!Data/*.py
!Data/plots/
!Data/plots/*.py

# Local live/paper run churn and generated research artifacts.
UI/swing_audit/**/*.jsonl
UI/swing_audit/**/*.json
**/plots/output/

# Generated/exported per-module data directories
strategies/multi_ticker_swing/data/training_export/
themes/theme_expansion_legacy/data/daily_bars/
themes/theme_expansion_legacy/data/ticker_profiles_cache/
themes/theme_expansion_legacy/outputs/**
!themes/theme_expansion_legacy/outputs/**/
!themes/theme_expansion_legacy/outputs/**/*.py

# Broker credentials — never commit (rotate if ever leaked)
core/API/Schwab_API/schwab_token.json
core/API/Schwab_API/schwab_tokens.json

# Re-include editor settings and code/config caught by blanket rules
!.vscode/settings.json
!**/config/*.json
!**/config/*.csv

# Re-include live pipeline dependencies (read by shared_universe / dynamic_theme)
!themes/theme_expansion_legacy/data/*.csv
!themes/theme_expansion_legacy/outputs/universe_filter.csv

# Re-include trained models distributed via git (loaded by live scorers)
!strategies/multi_ticker_swing/models/*.json
!strategies/multi_ticker_swing_htf/models/*.json

# ============================================================
# Model binaries & research artifacts (regenerable; do not commit)
# Live path uses the re-included *.json models above, not these bundles.
# ============================================================

# Serialized model bundles (none are tracked; live scorers read *.json)
*.joblib
*.native
*.npz

# Research model dirs (competition/OOF/expansion runs — bundles, metrics, plots)
strategies/momentum_expansion/models/expansion_v1/
strategies/multi_ticker_swing/models/competition_*/
strategies/multi_ticker_swing/models/oof_ranker_*/

# Backtest & forensics output (keep top-level analysis scripts in backtests/)
backtests/**
!backtests/*.py
strategies/**/backtest/results_*/
**/plots/family_compare/
UI/swing_audit/forensics_*/

# Generated data & exports
signals/meta_context/data/
themes/dynamic_theme/outputs/

# Plots/charts are all generated research output (none are UI assets)
*.png
