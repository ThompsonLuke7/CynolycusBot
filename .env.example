CYNOLYCUS_ENVIRONMENT=development
CYNOLYCUS_NERVOUS_SYSTEM_MODE=off
CYNOLYCUS_DATABASE_URL=postgresql+psycopg://cynolycus:cynolycus_dev_only@127.0.0.1:55432/cynolycus
CYNOLYCUS_DB_POOL_SIZE=5
CYNOLYCUS_DB_MAX_OVERFLOW=5
CYNOLYCUS_OPERATIONAL_ROOT=Data/operational/nervous_system
CYNOLYCUS_EXECUTION_JOURNAL=local
CYNOLYCUS_EXECUTION_JOURNAL_BUCKET=
CYNOLYCUS_ACCOUNT_ALIAS=paper

# --- QA-paper deployment (Task 26) -------------------------------------------
# Required when CYNOLYCUS_ENVIRONMENT=QA_PAPER. Development does not need them.
# The DSN accepts both shapes: a Cloud SQL Unix socket (Cloud Run) and
# private-IP TCP (the scheduler VM, which cannot lift into Cloud Run).
#   socket: postgresql+psycopg://USER:PASS@/cynolycus?host=/cloudsql/PROJECT:us-east5:INSTANCE
#   tcp:    postgresql+psycopg://USER:PASS@10.20.30.40:5432/cynolycus
CYNOLYCUS_GCP_PROJECT=
CYNOLYCUS_CLOUD_SQL_INSTANCE=
# Paper by construction. Identity is never inferred from the account alias.
CYNOLYCUS_ALPACA_BASE_URL=https://paper-api.alpaca.markets
CYNOLYCUS_ALPACA_ACCOUNT_ID=
# A reference to a secret, never the secret itself.
CYNOLYCUS_SECRET_BINDING=
# Its own bucket: retention policies are bucket-wide and would block the
# nightly rsync's overwrites if applied to the shared data bucket.
CYNOLYCUS_EXECUTION_JOURNAL_BUCKET=
# Deployment is not authorisation. Only the exact string "true" enables it.
CYNOLYCUS_SUBMIT_ENABLED=false
